@using Microsoft.AspNetCore.Identity;
@model TemplateDetailsVM
@inject UserManager<IdentityUser> UserManager
@{
    string? userId = Convert.ToString(TempData["userId"]);
    if(string.IsNullOrEmpty(userId))
    {
        userId = "";
    }
}
@section Stylesheets {
    <link href="~/css/details.css" rel="stylesheet" />
    <link href="~/css/intlTelInput.css" rel="stylesheet" />
    <link href="~/css/demo.css" rel="stylesheet" />
}
<span id="templateId" hidden>@Model.Template.TemplateId</span>
<div class="row mb-2 mt-1 mb-2"> 
    <div class="col-3">
        <a class="m-1 p-2 px-2 text-start text-center btn btn-sm btn-outline-info rounded-1" asp-area="Customer" asp-controller="Home" asp-action="Index">
            <i class="bi bi-arrow-bar-left"></i> Back
        </a>
    </div>      
</div>
<div class="card shadow border-0 mb-5 mt-1 pt-1">
    <div class="card-header bg-primary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white">Template Details</h2>
            </div>
        </div>        
    </div>
    <div class="card-body pt-4">
        <div class="row">
            <div class="col-12 col-md-3 mt-4">
                <div class="row mb-3">
                    <img src="@(Model != null ? $"https://drive.google.com/thumbnail?id={Model.Template.ImageId}" : "https://via.placeholder.com/1200x300")"
                         class="img-fluid rounded border border-secondary" alt="Template Image" />
                </div>

                <!-- Creator & Date Info -->
                <div class="d-flex justify-content-between mb-2">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-person-check-fill me-1"></i>
                        <span class="text-muted" style="font-size: 12px;">
                            @Model.Template.Creator.DisplayName
                        </span>
                    </div>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-calendar-check-fill me-1"></i>
                        <span class="text-muted" style="font-size: 12px;">
                            @Model.Template.CreatedDate
                        </span>
                    </div>
                </div>

                <!-- Like & Comment Section -->
                <div class="d-flex justify-content-between mb-2">
                    <a class="text-decoration-none" asp-area="Admin" asp-controller="Template" asp-action="LikeTemplate" asp-route-templateId="@Model.Template.TemplateId">
                        @if (Model.Likes.Any(u => u.LikerId == userId))
                        {
                            <i class="bi bi-hand-thumbs-up-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-hand-thumbs-up"></i>
                        }
                        <span id="templateLikeCount" class="badge bg-secondary">@Model.LikesCount</span>
                    </a>

                    <a class="text-decoration-none" href="#">
                        <i class="bi bi-chat-left-text"></i>
                        <span id="templateCommentCount" class="badge bg-secondary">@Model.CommentsCount</span>
                    </a>
                </div>

                <!-- Try It Button -->
                <a asp-area="Admin" asp-controller="Form" asp-action="Generate" asp-route-templateId="@Model.Template.TemplateId"
                   class="btn btn-info w-100 rounded-1 p-2" style="font-size: 12px;">
                    Try it
                </a>
            </div>

            <div class="col-12 text-center">
                 <h3 class="card-title text-center">
                    @(Model != null && !string.IsNullOrEmpty(Model.Template.Title) ? Model.Template.Title : "Empty title") – Template
                 </h3>
                <hr>
                <p class="text-center">
                    @(Model != null ? Html.Raw(Model.Template.Description) : "")
                </p>
                <div id="questions-list" class="list-group">
                    @foreach (var question in Model.Template.Questions.OrderBy(q => q.Order))
                    {
                        <div class="question-item list-group-item m-1 form-group" data-question-id="@question.TemplateQuestionId">  
                            @if(question.Type != "File")
                            {
                                <label name="questions[@question.TemplateQuestionId].text" value="@question.Text" class="form-control text-start mb-2 font-weight-bold bg-light">
                                    @question.Text
                                </label>
                            }
                            
                            <div class="response-container">
                                @switch (question.Type)
                                {
                                    case "SingleLine":
                                        <input type="text" class="form-control mb-1" placeholder="Response text" required="@(!question.IsOptional)" />
                                        break;
                                    case "MultiLine":
                                        <textarea class="form-control mb-1" placeholder="Response text" required="@(!question.IsOptional)"></textarea>
                                        break;
                                    case "Integer":
                                        <input type="number" min="1" max="125" class="form-control mb-1" placeholder="1" required="@(!question.IsOptional)" />
                                        break;
                                    case "CheckBox":
                                          <div class="form-check text-start ps-2 ms-3"> 
                                              <input class="form-check-input" type="checkbox" value="" id="Option1">
                                              <label class="form-check-label" for="defaultCheck1">
                                                  option 1
                                              </label>
                                          </div>
                                          <div class="form-check text-start ms-3 ps-2">
                                              <input class="form-check-input" type="checkbox" value="" id="Option2">
                                              <label class="form-check-label" for="defaultCheck2">
                                                  option 2
                                              </label>
                                          </div>
                                        break;
                                    case "RadioBox":
                                        <div class="form-check text-start ps-3 ms-4">
                                            <input class="form-check-input" type="radio" name="flexRadioOption" id="flexRadioOption1" checked>
                                            <label class="form-check-label ms-2" for="flexRadioOption1">
                                                option 1
                                            </label>
                                        </div>
                                        <div class="form-check text-start ms-4 ps-3">
                                            <input class="form-check-input" type="radio" name="flexRadioOption" id="flexRadioOption2">
                                            <label class="form-check-label ms-2" for="flexRadioOption2">
                                                option 2
                                            </label>
                                        </div>
                                        break;
                                    case "Date":    
                                    <input type="date" class="form-control mb-1" placeholder="Select a date" required="@(!question.IsOptional)" />
                                        break;
                                    case "Phone":
                                         <small class="text-info">Format: 123-456-789</small>
                                        <div class="input-group">
                                            <input class="input-group-text" type="tel" id="basic-addon1" value="+375" style="max-width:25px">
                                            <input type="tel" id="phone" name="phone" maxlength="9" pattern="[0-9]{3}-[0-9]{3}-[0-9]{3}" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*?)\..*/g, '$1');"
                                             required="@(!question.IsOptional)" placeholder="123-456-789">                                            
                                        </div>                                        
                                        break;                                   
                                    case "File":
                                        <div class="container-file">
                                            <input type="file" id="file-input_@question.TemplateQuestionId" data-question-id="@question.TemplateQuestionId" multiple required="@(!question.IsOptional)" />
                                            <label id="label-file" for="file-input_@question.TemplateQuestionId" onClick="collectFiles(@question.TemplateQuestionId)" name="questions[@question.TemplateQuestionId].text" value="@question.Text" class="form-control text-start mb-2 font-weight-bold">
                                                <i class="fa-solid fa-arrow-up-from-bracket"></i>
                                                @question.Text
                                            </label>
                                            <div class="num-of-files" id="num-of-files_@question.TemplateQuestionId">No Files Choosen</div>
                                            <ul id="files-list_@question.TemplateQuestionId"></ul>
                                        </div>
                                        break;
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="row text-center">
                     @if(Model.Template.Questions.Count() > 0)
                     {                         
                         <div class="col-12 text-center">
                             <button id="login-submit" type="submit" class="w-50 btn btn-lg btn-primary rounded-1 pt-2 pb-3 m-3" disabled="@(string.IsNullOrEmpty(UserManager.GetUserName(User)) ? true : false)">
                                 <i class="bi bi-binoculars-fill"></i> Submit
                             </button>
                         </div>                         
                     }
                     else
                     {                      
                         <div class="col-12 text-center">
                             No questions in this template at the moment.
                         </div>
                     }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script src="~/js/signalr.js"></script>
    <script src="~/js/templateDetails.js"></script>
    <script src="~/js/intlTelInput.js"></script>
    <script>
        var input = document.querySelector("#basic-addon1");
        if (input) {
            window.intlTelInput(input, {});
        }
    </script>
}
