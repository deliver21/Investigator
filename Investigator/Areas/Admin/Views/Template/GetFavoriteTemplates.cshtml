@model List<Like>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
<div class="container m-2">
    @if (Model.Count > 0)
    {
        @foreach (var like in Model)
        {
            @if(like.TemplateId > 0)
            {
                <div class="row border-bottom pb-3">
                    <div class="d-none d-lg-block col-lg-1 text-center py-2">
                        <img class="rounded" width="100%" src="@(Model != null ? $"https://drive.google.com/thumbnail?id={like.Template.ImageId}" : "~/Images/pharmacy-post-banner-background.jpg")" />
                    </div>
                    <div class="col-12 col-lg-6 pt-md-3">
                        <h5 class="text-uppercase text-secondary"><strong>@like.Template.Title</strong></h5>
                        <p><small>@Html.Raw(like.Template.Description)</small></p>
                    </div>
                    <div class="col-12  col-lg-5 text-center row">
                        <div class="col-3 text-md-right pt-2 pt-md-4">
                        </div>
                        <div class="col-6 col-sm-4 col-lg-6 pt-2">
                            <div class="w-75 btn-group" role="group">
                                <a asp-action="Details" asp-route-templateId="@like.TemplateId" class="btn btn-outline-primary bg-gradient py-2 rounded-1" title="@localizer["ViewThisTemplate"]">
                                    <i class="bi bi-binoculars"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }            
        }
    }
    else
    {
        <div class="row my-5"></div>
        <div class="row my-3"></div>
        <div class="row text-center">
            <div class="col-4"></div>
            <div class="col-4">
                 <h6 class="text-center mt-2"> @Localizer["YouHaventLikedAnyTemplatesYet"] :)</h6>                
            </div>
            <div class="col-4"></div>

        </div>
    }
</div>
