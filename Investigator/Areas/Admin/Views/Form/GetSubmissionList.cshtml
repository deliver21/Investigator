@model List<Form>
<div class="container m-2">
    @if (Model.Count > 0)
    {
        @foreach (var form in Model)
        {
            <div class="row border-bottom pb-3">
                <div class="d-none d-lg-block col-lg-1 text-center py-2">
                    <img class="rounded" width="100%" src="@(Model != null ? $"https://drive.google.com/thumbnail?id={form.ImageId}" : "~/Images/pharmacy-post-banner-background.jpg")" />
                </div>
                <div class="col-12 col-lg-6 pt-md-3">
                    <h5 class="text-uppercase text-secondary"><strong>@form.Title</strong></h5>
                    <p><small>@Html.Raw(form.Description)</small></p>
                </div>
                <div class="col-12  col-lg-5 text-center row">
                    <div class="col-3 text-md-right pt-2 pt-md-4">
                    </div>
                    <div class="col-6 col-sm-4 col-lg-6 pt-2">
                        <div class="w-75 btn-group" role="group">
                            <a asp-action="GetMySubmission" asp-route-idHashed="@form.IdHashed" class="btn btn-outline-primary bg-gradient py-2 rounded-1" title="Visualize your submission">
                                <i class="bi bi-binoculars"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
