@using System.Collections;
@model FormFillerVM
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@using Microsoft.AspNetCore.Http;
@{
    string currentUrl = Context.Request.Path;
}

﻿@{
    Layout = null;
}
<html lang="en">
    <head>
    <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Form submissions Table</title>
        <link rel="icon" type="image/svg" href="~/Images/Icon/binoculars-fill.svg" />
        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link rel="stylesheet" href="~/css/getSubmissions.css">
    </head>
    <body>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="row text-end mb-2 me-2">
            <partial name="_JiraHelpPartial" model="SD.AppBaseUrl+@currentUrl" />
        </div>        
    }
        <div class="container mb-4">

            <div class="row m-1 text-end">
            <div class="col-2">
                <a asp-area="Admin" asp-controller="Form" asp-action="Index" title="back to your form list" class="m-1 p-2 px-2 text-start text-center btn btn-sm btn-outline-info rounded-1">
                    <i class="bi bi-arrow-bar-left"></i>
                </a>
            </div>
                <div class="col-8">
                    <h3 class="text-white">@localizer["Submissionslist"]</h3>
                </div>
                <div class="col-2">
                <button id="exportButton" data-form-id="@Model.Form.FormId" title="Export submissions to a CSV file" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-down"></i>
                </button>

                </div>
            </div>
            <div class="row border-bottom pb-3">
                <div class="col-12 col-lg-3 offset-lg-1 text-center mb-3">
                      <img class="rounded" width="100%" src="@(Model != null ? $"https://drive.google.com/thumbnail?id={Model.Form.ImageId}" : "~/Images/pharmacy-post-banner-background.jpg")" />
                </div>
                <div class="col-12 col-lg-6 offset-lg-1">
                    <h5 class="text-uppercase text-secondary"><strong>@Model.Form.Title</strong></h5>
                    <p><small>@Html.Raw(Model.Form.Description)</small></p>
                </div>
            </div>
        
            <div class="row m-3">
                <div class="col-lg-3 col-md-6 mb-2 form-floating">
                    <input type="text" id="creator" class="form-control pb-2 pt-3" value="@Model.Form.Creator.Email" readonly>
                    <label for="creator" class="ms-2">Creator:</label>
                </div>
            <div class="col-lg-3 col-md-6 mb-2 form-floating">
                <input type="text" id="createdDate" class="form-control pb-2 pt-3" value="@Model.Form.CreatedDate" readonly>
                    <label for="createdDate" class="ms-2">Creation:</label>
                </div>
                <div class="col-lg-3 col-md-6 mb-2 form-floating">                    
                    <input id="questions" class="form-control" type="number" value="@Model.Questions.Count()" readonly>
                    <label for="questions" class="ms-2">Questions : </label>
                </div>
                <div class="col-lg-3 col-md-6 mb-2 form-floating">
                    <input id="contributors" class="form-control" type="number" value="@Model.FormFillers.Count()" readonly >
                    <label for="contributors" class="ms-2">Contributors: </label>
                </div>
            </div>
                
            <div class="table-responsive mb-3">
                <table id="tblData" class="table table-bordered table-striped table-hover table-responsive" style="width:100%; overflow:auto">
                    <thead>
                        <tr>
                            <th>Contributor</th>
                            @foreach (var question in Model.Questions)
                            {
                                <th>@question.Text</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var filler in Model.FormFillers)
                        {
                            <tr>
                                <td>@filler.ApplicationUser.Email</td>
                                @foreach (var response in filler.Responses.ToList())
                                {
                                    @if(response.Answer.Contains("https"))
                                    {
                                      <td>
                                        @foreach(var link in response.Answer.Split("\n"))
                                        {
                                            <a href="@link" target="_blank">@link.Trim()</a>
                                        }
                                      </td>
                                }else
                                     {
                                       <td>@response.Answer</td>
                                     }
                                
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>      
        </div>
          <script src="~/lib/jquery/dist/jquery.min.js"></script>
          <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
          <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
          
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
          <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
          <script src="~/js/getSubmissions.js"></script>
    
    </body>
</html>