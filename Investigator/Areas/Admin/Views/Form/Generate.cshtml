@model FormDto
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer localizer
@{
    ViewData["Title"] = "Generate form";
    string? serializeData = JsonConvert.SerializeObject(Model);
    int questionIdCount = 0;
}
@section Stylesheets {
    <link href="~/css/details.css" rel="stylesheet" />
    <link href="~/css/intlTelInput.css" rel="stylesheet" />
    <link href="~/css/demo.css" rel="stylesheet" />
}
<input type="hidden" id="baseUrl" value="@TempData["baseUrl"]" hidden>
<div class="form-container mb-2">
    <div class="row pt-2">
        <div class="col-3 col-md-3">
            <a class="m-1 p-2 px-2 text-start text-center btn btn-sm btn-outline-info rounded-1" asp-area="Customer" asp-controller="Home" asp-action="Index">
                <i class="bi bi-arrow-bar-left"></i> @localizer["Back"]
            </a>
        </div>
        <div class="col-6"></div>
    </div>
    <div class="card">
        <img src="@(Model != null ? $"https://drive.google.com/thumbnail?id={Model.Template.ImageId}" : "~/Images/pharmacy-post-banner-background.jpg")"
             class="card-img-top" alt="Event Image" style="max-height:100px; object-fit: cover;">
        <div class="card-body">
            <h3 class="card-title text-center">
                @(Model != null && !string.IsNullOrEmpty(Model.Title) ? Model.Template.Title : localizer["Emptytitle"]) – Form
            </h3>
            <hr>
            <p class="text-center">
                @(Model != null ? Html.Raw(Model.Description) : "")
            </p>
            <input name="formId" value="@Model.FormId" hidden>
            <input name="templateId" value="@Model.TemplateId" hidden>
            <input name="creatorId" value="@Model.CreatorId" hidden >
        </div>
    </div>
    <div id="questions-list" class="list-group">
        @foreach (var question in Model.Questions.OrderBy(q => q.Order))
        {            
            <div class="question-item list-group-item mb-1 mt-1" data-question-id="@question.QuestionId" data-question-type="@question.Type">
                @if(question.Type != "File")
                {
                    <input type="text" name="questions[@question.QuestionId].text" value="@question.Text"
                   placeholder="Question text" class="form-control mb-2 font-weight-bold" required>
                }
                
                <div class="response-container">
                    @switch (question.Type)
                    {
                        case "SingleLine":
                            <input type="text" class="form-control mb-1" placeholder="@localizer["Responsetext"]" required="@(!question.IsOptional)" />
                            break;
                        case "MultiLine":
                            <textarea name="MultiLine" class="form-control mb-1" placeholder="@localizer["Responsetext"]" required="@(!question.IsOptional)"></textarea>
                            break;
                        case "Integer":
                            <input type="number" min="0" class="form-control mb-1" placeholder="0" required="@(!question.IsOptional)" />
                            break;
                        case "CheckBox":
                                <button type="button" class="btn btn-sm btn-secondary p-0 mb-1 add-option"
                                    onclick="addCheckboxOption(this,@questionIdCount)"
                                    data-question-id="@questionIdCount">
                                         Add Option
                                </button>
                                <div class="new-options my-2" data-question-id="@questionIdCount">
                                    @foreach (var option in question.Options)
                                    {
                                         <input class="form-check-input" type="checkbox" id="@option.OptionId">
                                    <input class="form-control form-check-label" type="text" value="@option.Text" placeholder="@localizer["Enteroptiontext"]"
                                         data-option-id="@option.OptionId" style="display: inline-block; width: auto; margin-left: 10px;" />
                                    }
                                </div>
                            break;
                         case "RadioBox":
                                <button type="button" class="btn btn-sm btn-secondary p-0 mb-1 add-option"
                                   onclick="addRadioboxOption(this,@questionIdCount)"
                                   data-question-id="@questionIdCount">
                                    @localizer["AddOption"]
                                </button>
                                <div class="new-options my-2" data-question-id="@questionIdCount">
                                    @foreach (var option in question.Options)
                                    {
                                        <input class="form-check-input" type="checkbox" id="@option.OptionId">
                                        <input class="form-control form-check-label" type="text" value="@option.Text" placeholder="@localizer["Enteroptiontext"]"
                                         data-option-id="@option.OptionId" style="display: inline-block; width: auto; margin-left: 10px;" />
                                    }
                                </div>
                             break;
                        case "Date":
                            <input type="date" class="form-control mb-1" placeholder="@localizer["Selectadate"]" required="@(!question.IsOptional)" />
                            break;
                        case "Phone":
                            <div class="input-group">
                                <input class="input-group-text" type="tel" id="basic-addon1" value="+375" style="max-width:25px">
                                <input type="tel" id="phone" name="phone" maxlength="11"
                                 oninput="this.value = this.value
                                                         .replace(/\D/g, '')
                                                         .replace(/(\d{3})(\d{0,3})(\d{0,3})/, function(_, a, b, c) {
                                                           return [a, b, c].filter(Boolean).join('-');
                                                         });
                                                     "
                                 pattern="[0-9]{3}-[0-9]{3}-[0-9]{3}" required="@(!question.IsOptional)" placeholder="123-456-789">
                            </div>
                            break;
                        case "File":
                            <div class="container-file">
                                <input type="file" id="file-input" multiple required="@(!question.IsOptional)" />
                                <label disabled id="label-file" for="file-input" name="questions[@question.QuestionId].text" value="@question.Text" class="form-control text-start mb-2 font-weight-bold">
                                    <i class="fa-solid fa-arrow-up-from-bracket"></i>
                                    @question.Text
                                </label>
                            </div>
                            break;
                    }
                </div>
                <button class="btn btn-sm btn-warning rounded-1 text-start toggle-required" onclick="toggleRequired(event)">
                    @(question.IsOptional ? "Mark Required" : "Mark Optional")
                    </button>
                <button type="button" class="btn btn-sm btn-danger rounded-1 text-end m-1 delete-question">
                    <i class="bi bi-file-earmark-x"></i> @localizer["DeleteQuestion"]
                </button>
            </div>
            questionIdCount++;
        }
    </div>
    <button id="add-question" class="btn btn-primary rounded-1 mt-1 mb-5 pt-2 text-center"><i class="bi bi-file-earmark-plus"></i> @localizer["AddQuestion"]</button>
    <button id="save-form" type="submit" class="btn btn-success rounded-1 mt-1 mb-5 pt-2 text-center"><i class="bi bi-floppy"></i> @localizer["SaveForm"]</button>
</div>
@section Scripts{
    <script src="~/js/form.js"></script>
    <script src="~/js/intlTelInput.js"></script>
    <script>
         var input = document.querySelector("#basic-addon1");
        if (input) {
            window.intlTelInput(input, {});
        }
    </script>
}